{
  "name": "smallprint-mcp",
  "mcpName": "dev.smallprint/smallprint",
  "version": "1.1.0",
  "private": false,
  "description": "Ask before your agent uses an MCP server, skill or plugin: what its tool text said in the versions on record, what changed, and which advisories name it. Four read-only tools.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsup",
    "prepublishOnly": "node ../../ops/deploy/publish-guard.mjs && pnpm build",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  },
  "bin": {
    "smallprint-mcp": "dist/smallprint-mcp.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://smallprint.dev",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "agent-skills",
    "supply-chain",
    "security",
    "mcp-security",
    "tool-poisoning",
    "rug-pull",
    "prompt-injection",
    "drift-detection",
    "skills-security",
    "claude-code",
    "cursor"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gostanos/smallprint-action.git",
    "directory": "mcp"
  }
}
